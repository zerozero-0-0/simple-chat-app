{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/review-gate.sh\"",
            "statusMessage": "コミット前レビューの状態を確認中"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": ["Bash(bash .claude/hooks/review-gate.sh:*)"]
  }
}
